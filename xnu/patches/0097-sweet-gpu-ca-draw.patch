+/* The host answers every draw batch with {wire magic, sequence}. */
+IOReturn
+SweetVirtioConsole::sendWait(const void *data, size_t bytes, uint32_t sequence)
+{
+	struct { uint32_t magic; uint32_t sequence; } ack;
+	if (data == nullptr || bytes == 0 || bytes > kBufferSize) {
+		return kIOReturnBadArgument;
+	}
+	IOLockLock(gate);
+	IOReturn status = kIOReturnNotReady;
+	Queue &q = queues[1];
+	Queue &in = queues[0];
+	if (online) {
+		unsigned consumed = 0;
+		if (q.pending) {
+			status = complete(1, &consumed);
+		} else {
+			status = kIOReturnSuccess;
+		}
+		/* Drop a late acknowledgement from an earlier batch. */
+		if (status == kIOReturnSuccess && in.pending) {
+			unsigned dropped = 0;
+			completeWithin(0, &dropped, 0);
+		}
+		/* Give the host a receive buffer before it can answer. */
+		if (status == kIOReturnSuccess && !in.pending) {
+			post(0, kBufferSize);
+		}
+		if (status == kIOReturnSuccess) {
+			memcpy(q.data(), data, bytes);
+			post(1, (unsigned)bytes);
+			status = complete(1, &consumed);
+		}
+		if (status == kIOReturnSuccess) {
+			status = kIOReturnNotResponding;
+			for (unsigned tries = 0; tries < 4; tries++) {
+				unsigned got = 0;
+				IOReturn reply = completeWithin(0, &got, 250);
+				if (reply != kIOReturnSuccess) {
+					break;
+				}
+				if (got >= sizeof(ack)) {
+					memcpy(&ack, in.data(), sizeof(ack));
+					if (ack.magic == kGpuWireMagic &&
+					    ack.sequence == sequence) {
+						status = kIOReturnSuccess;
+						break;
+					}
+				}
+				post(0, kBufferSize);
+			}
+			if (!in.pending) {
+				post(0, kBufferSize);
+			}
+		}
+	}
+	IOLockUnlock(gate);
+	return status;
+}
