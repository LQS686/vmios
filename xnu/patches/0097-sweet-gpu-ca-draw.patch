+static void
+sweet_surface_locate(SweetSurface *s, struct sweet_gpu_surface_info *info)
+{
+	bzero(info, sizeof(*info));
+	info->width = s->width;
+	info->height = s->height;
+	info->bytes_per_row = s->bytesPerRow;
+	info->alloc = s->allocSize;
+	if (s->memory == NULL || s->allocSize == 0) {
+		return;
+	}
+	IOByteCount first = 0;
+	addr64_t pa = s->memory->getPhysicalSegment(0, &first, 0);
+	info->pa_lo = (uint32_t)pa;
+	info->pa_hi = (uint32_t)(pa >> 32);
+	IOByteCount offset = 0;
+	uint32_t runs = 0;
+	while (offset < s->allocSize && runs < 65536) {
+		IOByteCount length = 0;
+		if (s->memory->getPhysicalSegment(offset, &length, 0) == 0 ||
+		    length == 0) {
+			break;
+		}
+		runs++;
+		offset += length;
+	}
+	info->segments = runs;
+	info->flags = (runs == 1 && offset >= s->allocSize) ? 1 : 0;
+}
