+/*
+ * Reporter for ufsstats=1. A command that stays in the spin phase although
+ * ufswait=1 means the caller was in interrupt context or held a preemption
+ * level; the slept/cmds ratio is what decides whether the sleep path is
+ * worth keeping.
+ */
+static void
+ufs_stats_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t last_cmds = 0, last_bytes = 0, last_ns = 0;
+
+	printf("SWEET UFS: statistics every %u s (ufsstats=1)\n", ufs_stats_secs);
+	for (;;) {
+		(void)tsleep(&ufs_stats_chan, PZERO, "ufsstat", hz * (int)ufs_stats_secs);
+
+		lck_mtx_lock(&sweet_ufs_lock);
+		uint64_t cmds = ufs_st_cmds, bytes = ufs_st_bytes, ns = ufs_st_ns;
+		uint64_t max_ns = ufs_st_max_ns, slept = ufs_st_slept, errors = ufs_st_errors;
+		uint64_t reads = ufs_st_reads, writes = ufs_st_writes;
+		lck_mtx_unlock(&sweet_ufs_lock);
+
+		if (cmds == last_cmds) {
+			continue;               /* idle: nothing changed */
+		}
+		uint64_t delta = cmds - last_cmds;
+		printf("SWEET UFS: %llu cmds (%llu rd/%llu wr, +%llu), %llu KiB (+%llu), "
+		    "avg %llu us, max %llu us, slept %llu, errors %llu\n",
+		    cmds, reads, writes, delta, bytes >> 10, (bytes - last_bytes) >> 10,
+		    (ns - last_ns) / delta / 1000, max_ns / 1000, slept, errors);
+		last_cmds = cmds;
+		last_bytes = bytes;
+		last_ns = ns;
+	}
+}
+
+static void
+ufs_stats_start(void)
+{
+	thread_t thread;
+
+	if (!ufs_stats_on) {
+		return;
+	}
+	PE_parse_boot_argn("ufsstatsecs", &ufs_stats_secs, sizeof(ufs_stats_secs));
+	if (ufs_stats_secs == 0 || ufs_stats_secs > 60) {
+		ufs_stats_secs = 10;
+	}
+	if (kernel_thread_start(ufs_stats_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
 
