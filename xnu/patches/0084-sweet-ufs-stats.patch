+/*
+ * Command statistics (boot-arg ufsstats=1, report every ufsstatsecs=10 s).
+ * One command at a time on slot 0 makes the controller a serial resource;
+ * these counters show what it is actually asked to do and how long each
+ * command takes, which is the input to "should the bounce buffer, the slot
+ * count or the delay(1) polling change". They also show whether ufswait=1
+ * really converts spinning into sleeping (slept vs cmds).
+ *
+ * ufs_scsi() runs under sweet_ufs_lock, so the counters need no atomics;
+ * the reporter copies them under the same lock.
+ */
+static bool ufs_stats_on;
+static uint32_t ufs_stats_secs = 10;
+static int ufs_stats_chan;
+static uint64_t ufs_st_cmds, ufs_st_reads, ufs_st_writes, ufs_st_bytes;
+static uint64_t ufs_st_ns, ufs_st_max_ns, ufs_st_slept, ufs_st_errors;
+
+/* Called at the end of every command, under sweet_ufs_lock. */
+static void
+ufs_stat(uint64_t t0, uint32_t len, bool write, bool slept, bool ok)
+{
+	if (!ufs_stats_on) {
+		return;
+	}
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	ufs_st_cmds++;
+	if (write) {
+		ufs_st_writes++;
+	} else {
+		ufs_st_reads++;
+	}
+	if (!ok) {
+		ufs_st_errors++;
+	}
+	ufs_st_bytes += len;
+	ufs_st_ns += ns;
+	if (slept) {
+		ufs_st_slept++;
+	}
+	if (ns > ufs_st_max_ns) {
+		ufs_st_max_ns = ns;
+	}
+}
