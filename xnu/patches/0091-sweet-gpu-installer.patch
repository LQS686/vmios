diff --git a/iokit/Kernel/arm/SweetGPUInstaller.cpp b/iokit/Kernel/arm/SweetGPUInstaller.cpp
new file mode 100644
index 0000000..641080c
--- /dev/null
+++ b/iokit/Kernel/arm/SweetGPUInstaller.cpp
@@ -0,0 +1,295 @@
+/*
+ * SweetGPUInstaller: installs a Metal plugin bundle into the guest root.
+ *
+ * The virtual GPU is a userland Metal plugin: Metal builds
+ * /System/Library/Extensions/<MetalPluginName>.bundle and instantiates the
+ * class named by MetalPluginClassName (see _getMetalPluginClassForService in
+ * Metal.framework). The guest root is only writable from inside the guest, so
+ * the ADT carries the bundle as an SGB1 blob and this driver writes it with
+ * the kernel's VFS once the root is mounted.
+ *
+ * Creating a new .bundle directory needs the private nameidata API, which is
+ * not visible to IOKit sources, so the ADT points at the existing
+ * AGXMetalA11.bundle. The original Info.plist is kept as Info.plist.orig and
+ * sweetmetal_restore=1 puts it back.
+ */
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <libkern/c++/OSData.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+#include <sys/vnode.h>
+#include <sys/fcntl.h>
+#include <sys/uio.h>
+
+namespace {
+
+constexpr unsigned kMaxFileSize = 256 * 1024;
+
+const char *
+data_string(OSData *data)
+{
+	return data ? static_cast<const char *>(data->getBytesNoCopy()) : nullptr;
+}
+
+bool
+sweet_exists(const char *path)
+{
+	vnode_t vp = NULLVP;
+	if (vnode_lookup(path, 0, &vp, vfs_context_kernel()) != 0) {
+		return false;
+	}
+	vnode_put(vp);
+	return true;
+}
+
+errno_t
+sweet_write(const char *path, const void *bytes, unsigned int size)
+{
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx = vfs_context_kernel();
+	errno_t error = vnode_open(path, O_CREAT | O_TRUNC | FWRITE, 0644, 0, &vp, ctx);
+	if (error) {
+		return error;
+	}
+	if (size != 0) {
+		int residual = 0;
+		error = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)bytes, (int)size, 0,
+		    UIO_SYSSPACE, IO_SYNC, vfs_context_ucred(ctx), &residual, NULL);
+		if (error == 0 && residual != 0) {
+			error = EIO;
+		}
+	}
+	vnode_close(vp, FWRITE, ctx);
+	return error;
+}
+
+errno_t
+sweet_read(const char *path, void *buffer, unsigned int capacity, unsigned int *size)
+{
+	vnode_t vp = NULLVP;
+	vfs_context_t ctx = vfs_context_kernel();
+	errno_t error = vnode_open(path, O_RDONLY, 0, 0, &vp, ctx);
+	*size = 0;
+	if (error) {
+		return error;
+	}
+	int residual = 0;
+	error = vn_rdwr(UIO_READ, vp, (caddr_t)buffer, (int)capacity, 0, UIO_SYSSPACE,
+	    IO_SYNC, vfs_context_ucred(ctx), &residual, NULL);
+	if (error == 0) {
+		*size = capacity - (unsigned int)residual;
+	}
+	vnode_close(vp, FREAD, ctx);
+	return error;
+}
+
+/* Keep the first original next to the file, so one boot can undo the install. */
+errno_t
+sweet_backup(const char *path)
+{
+	char original[1024];
+	if (snprintf(original, sizeof(original), "%s.orig", path) >= (int)sizeof(original)) {
+		return ENAMETOOLONG;
+	}
+	if (sweet_exists(original)) {
+		return 0;
+	}
+	void *buffer = IOMalloc(kMaxFileSize);
+	if (buffer == nullptr) {
+		return ENOMEM;
+	}
+	unsigned int size = 0;
+	errno_t error = sweet_read(path, buffer, kMaxFileSize, &size);
+	if (error == 0) {
+		error = sweet_write(original, buffer, size);
+	}
+	IOLog("SWEET GPU: backup %s (%u bytes) -> %d\n", original, size, error);
+	IOFree(buffer, kMaxFileSize);
+	return error;
+}
+
+bool
+unsafe_name(const char *name)
+{
+	for (const char *p = name; *p != 0; p++) {
+		if (p[0] == '.' && p[1] == '.' && (p[2] == '/' || p[2] == 0) &&
+		    (p == name || p[-1] == '/')) {
+			return true;
+		}
+	}
+	return name[0] == '/' || name[0] == 0;
+}
+
+errno_t
+sweet_install(const char *base, const unsigned char *blob, unsigned int length)
+{
+	if (length < 8 || memcmp(blob, "SGB1", 4) != 0) {
+		return EINVAL;
+	}
+	if (!sweet_exists(base)) {
+		return ENOENT;
+	}
+	uint32_t count;
+	memcpy(&count, blob + 4, sizeof(count));
+	unsigned int offset = 8;
+	for (uint32_t i = 0; i < count; i++) {
+		if (offset + 2 > length) {
+			return EINVAL;
+		}
+		uint16_t nameLength;
+		memcpy(&nameLength, blob + offset, sizeof(nameLength));
+		offset += 2;
+		if (nameLength == 0 || nameLength > 512 ||
+		    nameLength + 4 > length - offset) {
+			return EINVAL;
+		}
+		char name[513];
+		memcpy(name, blob + offset, nameLength);
+		name[nameLength] = 0;
+		offset += nameLength;
+		uint32_t size;
+		memcpy(&size, blob + offset, sizeof(size));
+		offset += 4;
+		if (size > length || offset > length - size || unsafe_name(name)) {
+			return EINVAL;
+		}
+		char path[1024];
+		if (snprintf(path, sizeof(path), "%s/%s", base, name) >= (int)sizeof(path)) {
+			return ENAMETOOLONG;
+		}
+		errno_t error = 0;
+		if (strcmp(name, "Info.plist") == 0) {
+			error = sweet_backup(path);
+			if (error) {
+				return error;
+			}
+		}
+		error = sweet_write(path, blob + offset, size);
+		IOLog("SWEET GPU: install %s (%u bytes) -> %d\n", path, size, error);
+		if (error) {
+			return error;
+		}
+		offset += size;
+	}
+	return 0;
+}
+
+errno_t
+sweet_restore(const char *base)
+{
+	char info[1024], original[1024];
+	if (snprintf(info, sizeof(info), "%s/Info.plist", base) >= (int)sizeof(info) ||
+	    snprintf(original, sizeof(original), "%s/Info.plist.orig", base) >=
+	    (int)sizeof(original)) {
+		return ENAMETOOLONG;
+	}
+	void *buffer = IOMalloc(kMaxFileSize);
+	if (buffer == nullptr) {
+		return ENOMEM;
+	}
+	unsigned int size = 0;
+	errno_t error = sweet_read(original, buffer, kMaxFileSize, &size);
+	if (error == 0) {
+		error = sweet_write(info, buffer, size);
+	}
+	IOLog("SWEET GPU: restore %s (%u bytes) -> %d\n", info, size, error);
+	IOFree(buffer, kMaxFileSize);
+	return error;
+}
+
+} /* namespace */
+
+class SweetGPUInstaller : public IOService {
+	OSDeclareDefaultStructors(SweetGPUInstaller);
+
+	OSData *base = nullptr;
+	OSData *blob = nullptr;
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void free() APPLE_KEXT_OVERRIDE;
+
+	const char *basePath() const { return data_string(base); }
+	const unsigned char *blobBytes() const {
+		return blob ? static_cast<const unsigned char *>(blob->getBytesNoCopy()) : nullptr;
+	}
+	unsigned int blobLength() const { return blob ? blob->getLength() : 0; }
+};
+
+OSDefineMetaClassAndStructors(SweetGPUInstaller, IOService);
+
+static void
+sweet_install_thread(void *arg, wait_result_t wait_result)
+{
+	SweetGPUInstaller *installer = static_cast<SweetGPUInstaller *>(arg);
+	errno_t error = ENOENT;
+	int restore = 0;
+
+	(void)wait_result;
+	if (PE_parse_boot_argn("sweetmetal_restore", &restore, sizeof(restore)) && restore) {
+		for (unsigned i = 0; i < 600; i++) {
+			error = sweet_restore(installer->basePath());
+			if (error == 0) {
+				break;
+			}
+			IOSleep(1000);
+		}
+		IOLog("SWEET GPU: restore %s (%d)\n", error ? "failed" : "done", error);
+		installer->release();
+		return;
+	}
+
+	/* IOKit matches before vfs_mountroot; retry until the root is writable. */
+	for (unsigned i = 0; i < 600; i++) {
+		error = sweet_install(installer->basePath(), installer->blobBytes(),
+		    installer->blobLength());
+		if (error == 0) {
+			break;
+		}
+		IOSleep(1000);
+	}
+	IOLog("SWEET GPU: bundle install %s (%d)\n", error ? "failed" : "done", error);
+	installer->release();
+}
+
+bool
+SweetGPUInstaller::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	OSData *baseData = OSDynamicCast(OSData, provider->getProperty("base"));
+	OSData *blobData = OSDynamicCast(OSData, provider->getProperty("bundle"));
+	if (baseData == nullptr || blobData == nullptr || data_string(baseData) == nullptr) {
+		return false;
+	}
+	base = baseData;
+	blob = blobData;
+	base->retain();
+	blob->retain();
+	registerService();
+
+	thread_t thread = nullptr;
+	retain();
+	if (kernel_thread_start((thread_continue_t)sweet_install_thread, this,
+	    &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		release();
+		IOLog("SWEET GPU: could not start the bundle installer\n");
+	}
+	IOLog("SWEET GPU: installer armed for %s, %u bytes\n", basePath(),
+	    blob->getLength());
+	return true;
+}
+
+void
+SweetGPUInstaller::free()
+{
+	OSSafeReleaseNULL(base);
+	OSSafeReleaseNULL(blob);
+	IOService::free();
+}
