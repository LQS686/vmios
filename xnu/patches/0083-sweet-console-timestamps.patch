+/*
+ * Boot timeline (boot-arg sweetts=1). The console log is the only trace of
+ * what the kernel does between early start and launchd, and it has no
+ * timestamps: a 31 s hole in it cannot be attributed to anything. With
+ * sweetts=1 every line that reaches the console is prefixed with
+ * "[seconds.milliseconds] " taken from the ARM generic timer, which counts
+ * from reset, so gaps in the log become gaps in time.
+ *
+ * The prefix is a fixed 13 bytes ("[" 6 digits "." 3 digits "] ") so a
+ * chunk's ring space can be reserved with one atomic add before writing.
+ */
+#define SWEET_TS_LEN    13u
+
+static uint32_t
+sweet_ts_prefix(char *out)
+{
+	static const uint32_t digits[6] = { 100000u, 10000u, 1000u, 100u, 10u, 1u };
+	char msbuf[3];
+
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	uint64_t secs = ns / NSEC_PER_SEC;
+	uint32_t ms = (uint32_t)((ns % NSEC_PER_SEC) / NSEC_PER_MSEC);
+	uint32_t n = 0;
+	if (secs > 999999) {
+		secs = 999999;           /* saturate: 11.5 days of uptime */
+	}
+	msbuf[0] = (char)('0' + ms / 100);
+	msbuf[1] = (char)('0' + (ms / 10) % 10);
+	msbuf[2] = (char)('0' + ms % 10);
+	out[n++] = '[';
+	for (int i = 0; i < 6; i++) {
+		out[n++] = (char)('0' + (secs / digits[i]) % 10);
+	}
+	out[n++] = '.';
+	out[n++] = msbuf[0];
+	out[n++] = msbuf[1];
+	out[n++] = msbuf[2];
+	out[n++] = ']';
+	out[n++] = ' ';
+	return n;
+}
+
 /* Called for all console output, any context: never blocks. */
 void sweet_log_append(const char *c, int size);
 
