+	}
+	if (selector == kSweetGPUClearSurface) {
+		struct {
+			uint32_t surface, color, x, y, width, height;
+		} request;
+		if (args->structureInput == NULL ||
+		    args->structureInputSize < sizeof(request)) {
+			return kIOReturnBadArgument;
+		}
+		memcpy(&request, args->structureInput, sizeof(request));
+		SweetSurface *s = sweet_surface_copy(request.surface);
+		if (s == NULL) {
+			return kIOReturnNotFound;
+		}
+		uint32_t bytesPerRow = s->bytesPerRow;
+		uint32_t allocSize = s->allocSize;
+		uint32_t surfaceWidth = s->width;
+		uint32_t surfaceHeight = s->height;
+		IOByteCount segment = 0;
+		addr64_t pa = s->memory != NULL ?
+		    s->memory->getPhysicalSegment(0, &segment) : 0;
+		IOReturn result = kIOReturnOffline;
+		if (pa != 0 && segment >= allocSize) {
+			struct {
+				struct sweet_gpu_wire_header header;
+				struct sweet_gpu_wire_fill fill;
+			} __attribute__((packed)) message;
+			message.header.magic = SWEET_GPU_WIRE_MAGIC;
+			message.header.version = SWEET_GPU_WIRE_VERSION;
+			message.header.operation = SWEET_GPU_WIRE_FILL;
+			message.header.bytes = sizeof(message.fill);
+			message.header.request = request.surface;
