+bool
+AppleCLCD::offloadRow(SweetSurface *surface, IOByteCount source,
+    uint32_t destination, uint32_t length)
+{
+	while (length != 0) {
+		uint32_t count = fOffload->count;
+		if (count >= SWEET_FB_OFFLOAD_MAX) {
+			return false;
+		}
+		IOByteCount segment = 0;
+		addr64_t physical = surface->memory->getPhysicalSegment(
+		    source, &segment, kIOMemoryMapperNone);
+		if (physical == 0 || segment == 0) {
+			return false;
+		}
+		uint32_t chunk = (uint32_t)(segment < length ? segment : length);
+		volatile sweet_fb_offload_descriptor *d =
+		    (volatile sweet_fb_offload_descriptor *)(
+		    (uintptr_t)fOffload + SWEET_FB_OFFLOAD_HEADER) + count;
+		d->source = physical;
+		d->destination = destination;
+		d->length = chunk;
+		fOffload->count = count + 1;
+		source += chunk;
+		destination += chunk;
+		length -= chunk;
+	}
+	return true;
+}
